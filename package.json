{
  "name": "seekr",
  "private": false,
  "version": "1.0.0",
  "description": "Instant file search for macOS, Windows and Linux",
  "author": "k6w",
  "homepage": "https://github.com/k6w/seekr-app",
  "repository": {
    "type": "git",
    "url": "https://github.com/k6w/seekr-app.git"
  },
  "bugs": {
    "url": "https://github.com/k6w/seekr-app/issues"
  },
  "license": "MIT",
  "keywords": [
    "file-search",
    "electron",
    "desktop-app",
    "search",
    "fuzzy-search"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm tsc && vite build && electron-builder --publish never",
    "build:win": "pnpm tsc && vite build && electron-builder --win --publish never",
    "build:mac": "pnpm tsc && vite build && electron-builder --mac --publish never",
    "build:linux": "pnpm tsc && vite build && electron-builder --linux --publish never",
    "tsc": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.strict.json",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 50",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "clean": "rimraf dist dist-electron release",
    "lint:strict": "eslint electron tests --ext ts --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/typography": "^0.5.16",
    "autoprefixer": "^10.4.21",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.536.0",
    "postcss": "^8.5.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^3.3.1",
    "uuid": "^11.1.0",
    "electron-log": "^5.4.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.1.0",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^3.2.7",
    "@electron/notarize": "^3.0.1"
  },
  "main": "dist-electron/main.js"
}
