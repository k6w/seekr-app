// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.k6w.seekr",
  "productName": "Seekr",
  "copyright": "Copyright © 2026 k6w",
  "asar": true,
  "afterSign": "scripts/notarize.cjs",

  // Native .node binaries cannot be dlopen'd from inside an asar archive.
  // better-sqlite3 resolves its binding by probing the filesystem, which fails
  // once packed. Without this the packaged app crashes on launch while dev
  // works fine -- and nothing in CI would notice.
  "asarUnpack": [
    "**/*.node"
  ],

  "directories": {
    "output": "release/${version}",
    "buildResources": "build"
  },

  "files": [
    "dist",
    "dist-electron",
    // better-sqlite3 13 ships N-API prebuilds and resolves them by probing
    // the filesystem for prebuilds/<platform>-<arch>.node. Ship lib/ and
    // prebuilds/ only -- not deps/ (the ~9MB SQLite amalgamation source),
    // src/, or the node-gyp build intermediates.
    "!**/*.map",
    "!node_modules/better-sqlite3/deps/**",
    "!node_modules/better-sqlite3/src/**",
    "!node_modules/better-sqlite3/build/**",
    "!node_modules/better-sqlite3/binding.gyp"
  ],

  "nodeGypRebuild": false,
  "buildDependenciesFromSource": false,
  "npmRebuild": true,

  "mac": {
    // Was arm64-only (inherited from the macos-latest runner), so Intel Macs
    // got no build at all.
    "target": [
      { "target": "dmg", "arch": ["arm64", "x64"] },
      // electron-updater cannot update from a bare dmg; it needs a zip.
      { "target": "zip", "arch": ["arm64", "x64"] }
    ],
    "category": "public.app-category.utilities",
    "icon": "build/icon.icns",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.plist",
    // Signing identity comes from CSC_LINK / CSC_KEY_PASSWORD in CI, and
    // notarization from APPLE_ID / APPLE_APP_SPECIFIC_PASSWORD / APPLE_TEAM_ID.
    // Set SEEKR_SKIP_NOTARIZE=1 for local unsigned builds.
    "notarize": true,
    "artifactName": "Seekr-mac-${version}-${arch}.${ext}",
    "extendInfo": {
      // macOS shows these strings in the permission prompts. Without them the
      // prompt is never presented and the directories silently return EPERM.
      "NSDesktopFolderUsageDescription": "Seekr indexes your Desktop so you can search it instantly.",
      "NSDocumentsFolderUsageDescription": "Seekr indexes your Documents so you can search them instantly.",
      "NSDownloadsFolderUsageDescription": "Seekr indexes your Downloads so you can search them instantly.",
      "NSRemovableVolumesUsageDescription": "Seekr indexes external drives you choose to include.",
      "NSSystemAdministrationUsageDescription": "Full Disk Access lets Seekr index every folder you choose, including those macOS protects by default.",
      "LSMinimumSystemVersion": "11.0"
    }
  },

  "dmg": {
    "artifactName": "Seekr-mac-${version}-${arch}.${ext}",
    "contents": [
      { "x": 130, "y": 220, "type": "file" },
      { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
    ]
  },

  "win": {
    "target": [
      { "target": "nsis", "arch": ["x64", "arm64"] },
      { "target": "portable", "arch": ["x64"] }
    ],
    "icon": "build/icon.png",
    // electron-builder 26 moved signing options under signtoolOptions.
    // The certificate itself comes from WIN_CSC_LINK / WIN_CSC_KEY_PASSWORD.
    "signtoolOptions": {
      "rfc3161TimeStampServer": "http://timestamp.digicert.com"
    },
    "artifactName": "Seekr-win-${version}-${arch}.${ext}"
  },

  "nsis": {
    "oneClick": false,
    // Deliberately per-user: perMachine would force a UAC prompt on every
    // install and break per-user auto-update. The optional privileged indexing
    // service is installed separately, on demand, from inside the app.
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Seekr",
    "deleteAppDataOnUninstall": false,
    "artifactName": "Seekr-win-${version}-${arch}-Setup.${ext}",
    "license": "LICENSE",
    "menuCategory": "Utilities"
  },

  "portable": {
    "artifactName": "Seekr-win-${version}-Portable.${ext}"
  },

  "linux": {
    "target": ["AppImage", "deb", "rpm"],
    "icon": "build/icons",
    "category": "Utility",
    "synopsis": "Instant file search",
    "description": "Seekr finds files on your machine as fast as you can type.",
    // Must match app.setDesktopName() in main.ts for the Wayland
    // GlobalShortcuts portal to identify us.
    "desktop": {
      "entry": {
        "Name": "Seekr",
        "StartupWMClass": "Seekr"
      }
    },
    "artifactName": "Seekr-linux-${version}-${arch}.${ext}"
  }
}
